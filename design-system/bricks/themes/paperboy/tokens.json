{
  "theme": {
    "name": "paperboy",
    "label": "Paperboy",
    "cssVariablePrefix": "--bricks-",
    "modes": [
      "light",
      "dark"
    ],
    "source": "Interpretation of an open-source news design system: blue, teal and amber on neutral greys",
    "disclaimer": "An independent visual interpretation created by the author for portfolio purposes. Not an official source and not affiliated with or endorsed by any company. Values are adapted, not reproduced.",
    "typography": {
      "families": {
        "display": {
          "family": "Poppins",
          "stack": "Poppins, system-ui, sans-serif"
        },
        "highlight": {
          "family": "Bitter",
          "stack": "Bitter, Georgia, serif"
        },
        "body": {
          "family": "DM Sans",
          "stack": "\"DM Sans\", system-ui, sans-serif"
        },
        "mono": {
          "family": "DM Mono",
          "stack": "\"DM Mono\", ui-monospace, Menlo, monospace"
        }
      },
      "weights": {
        "display": {
          "weight": 700,
          "style": "normal",
          "figmaStyle": "Bold"
        },
        "highlight": {
          "weight": 700,
          "style": "normal",
          "figmaStyle": "Bold"
        },
        "heading": {
          "weight": 600,
          "style": "normal",
          "figmaStyle": "SemiBold"
        },
        "label": {
          "weight": 500,
          "style": "normal",
          "figmaStyle": "Medium"
        },
        "body": {
          "weight": 400,
          "style": "normal",
          "figmaStyle": "Regular"
        }
      },
      "note": "heading and label use the display family. weights[role] drives font-weight and font-style for that role."
    }
  },
