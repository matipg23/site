    "typography": {
      "families": {
        "display": {
          "family": "Zalando Sans Expanded",
          "stack": "\"Zalando Sans Expanded\", system-ui, sans-serif"
        },
        "highlight": {
          "family": "Barlow Semi Condensed",
          "stack": "\"Barlow Semi Condensed\", system-ui, sans-serif"
        },
        "body": {
          "family": "Public Sans",
          "stack": "\"Public Sans\", system-ui, sans-serif"
        },
        "mono": {
          "family": "Kode Mono",
          "stack": "\"Kode Mono\", ui-monospace, Menlo, monospace"
        }
      },
      "weights": {
        "display": {
          "weight": 900,
          "style": "italic",
          "figmaStyle": "Black Italic"
        },
        "highlight": {
          "weight": 900,
          "style": "italic",
          "figmaStyle": "Black Italic"
        },
        "heading": {
          "weight": 900,
          "style": "normal",
          "figmaStyle": "Black"
        },
        "label": {
          "weight": 700,
          "style": "normal",
          "figmaStyle": "Bold"
        },
        "body": {
          "weight": 300,
          "style": "normal",
          "figmaStyle": "Light"
        }
      },
      "note": "heading and label use the display family. weights[role] drives font-weight and font-style for that role."
    }
  },
